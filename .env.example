VPNW_HOST=0.0.0.0
VPNW_PORT=8000
VPNW_CORS_ORIGINS=https://your-miniapp-domain
VPNW_SESSION_TTL_SECONDS=86400
VPNW_SESSION_LIMIT=512

VPNW_BOT_TOKEN=
# Required for the browser Telegram Login Widget — without it, browser login is
# silently disabled (miniapp login still works via initData).
VPNW_BOT_USERNAME=
# Optional when another process owns polling: validates Telegram Mini App
# initData without starting this service's legacy poller.
VPNW_TELEGRAM_AUTH_TOKEN=
VPNW_MINIAPP_URL=https://your-miniapp-domain/miniapp
VPNW_REQUIRED_CHANNEL=@fodders_dev

# Optional managed AmneziaWG access tied to a Remnawave subscription.
VPNW_REMNAWAVE_API_URL=http://127.0.0.1:3000
VPNW_REMNAWAVE_API_KEY=
VPNW_REMNAWAVE_WEBHOOK_SECRET=
VPNW_AWG_FALLBACK_HOST=
VPNW_AWG_FALLBACK_SSH_USER=root
VPNW_AWG_FALLBACK_SSH_PORT=22
VPNW_AWG_FALLBACK_SSH_KEY=
VPNW_AWG_FALLBACK_LISTEN_PORT=
VPNW_AWG_LINK_SECRET=
