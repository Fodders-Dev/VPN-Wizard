VPNW_HOST=0.0.0.0
VPNW_PORT=8000
VPNW_CORS_ORIGINS=https://your-miniapp-domain
VPNW_SESSION_TTL_SECONDS=86400
VPNW_SESSION_LIMIT=512

VPNW_BOT_TOKEN=
VPNW_MINIAPP_URL=https://your-miniapp-domain/miniapp
VPNW_REQUIRED_CHANNEL=@fodders_dev

# --- Reality transport (optional) -------------------------------------------
# tcp (default) = canonical TCP + xtls-rprx-vision, max client compatibility.
# xhttp = opt-in newer transport (some networks prefer it; less compatible with old clients).
# VPNW_PROXY_TRANSPORT=tcp

# --- Whitelist-friendly proxy via Yandex Cloud (owner-only) -----------------
# Telegram user IDs allowed to invoke /wl /wl_add. Comma-separated.
# Find your ID with @userinfobot in Telegram.
# VPNW_OWNER_IDS=123456789

# SSH access to the VPS that hosts the WL inbound (typically your existing Reality VPS).
# Either VPNW_WL_VPS_PASSWORD or VPNW_WL_VPS_KEY_PATH must be set.
# VPNW_WL_VPS_HOST=1.2.3.4
# VPNW_WL_VPS_USER=root
# VPNW_WL_VPS_PORT=22
# VPNW_WL_VPS_PASSWORD=
# VPNW_WL_VPS_KEY_PATH=/etc/vpn-wizard/wl_vps_id_ed25519

# Yandex Cloud OAuth token. Get it once at:
#   https://oauth.yandex.ru/authorize?response_type=token&client_id=1a6990aa636648e9b2ef855fa7bec2fb
# Click "Allow", copy the access_token from the redirect URL. Used to mint short-lived IAM tokens.
# YC_OAUTH_TOKEN=

# Optional: pin a specific Yandex Cloud folder (otherwise first ACTIVE folder is auto-selected).
# YC_FOLDER_ID=

# Optional: name of the API Gateway resource in Yandex Cloud.
# VPNW_WL_GATEWAY_NAME=vpn-wl

# Optional: VPS port for the new VLESS-XHTTP+TLS inbound. Default 9443 — picked
# to avoid the common 8443 fallback used by Reality on hosts where 443 is taken.
# VPNW_WL_LISTEN_PORT=9443

# ACME challenge mode for the WL cert. Options:
#   - "auto"       (default) prefer webroot if nginx is active, else standalone.
#                  Convenient for first-time setup but does an automatic fallback;
#                  pin "webroot" explicitly on production hosts (see below).
#   - "webroot"    *** RECOMMENDED FOR PRODUCTION on hosts running nginx ***
#                  Requires an active nginx. Bot drops a hostname-scoped
#                  server block in /etc/nginx/conf.d/ that ONLY answers
#                  /.well-known/acme-challenge/ for <ip-dashes>.sslip.io.
#                  nginx -t validates before reload; snippet is rolled back
#                  on validation failure. Other vhosts are untouched. Zero
#                  downtime for cert issuance and renewals. Strict: if nginx
#                  is not active, /wl_add fails — never silently falls back
#                  to standalone, never stops nginx.
#   - "standalone" let acme.sh take :80 directly (legacy / non-nginx hosts).
# VPNW_WL_ACME_MODE=webroot

# Standalone-mode fallback only. DO NOT SET on production hosts running nginx
# alongside other projects — bot can never stop nginx in webroot mode, but
# this variable would let it stop nginx in standalone mode. Leave unset
# unless you genuinely have no web server on the box.
#   - "nginx"  — only stop if the process on :80 actually matches "nginx"
#   - "auto"   — stop whatever process currently owns :80 (use with care)
#   - unset    — bot aborts with a clear error if :80 is busy (default).
# VPNW_WL_STOP_PORT80_SERVICE=
