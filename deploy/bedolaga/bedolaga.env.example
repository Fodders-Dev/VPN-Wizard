# Fodder VPN 2 — Bedolaga shop-bot env (curated subset, tuned for our MVP).
#
# Bedolaga has ~1100 env vars. This file lists ONLY what you must set for the MVP;
# copy the upstream .env.example first, then overwrite these keys.
#   git clone https://github.com/BEDOLAGA-DEV/remnawave-bedolaga-telegram-bot bedolaga
#   cd bedolaga && cp .env.example .env
#   # then set the values below in .env
# Upstream reference: https://github.com/BEDOLAGA-DEV/remnawave-bedolaga-telegram-bot
#
# Money is in KOPEKS everywhere: 15000 = 150.00 RUB.

### Bot & admin ###
BOT_TOKEN=                       # <<< SET (BotFather token for a NEW bot)
ADMIN_IDS=                       # <<< SET (your numeric Telegram id; comma-separated for several)

### Bot's own database / redis (separate from the panel's DB) ###
DATABASE_MODE=auto
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=remnawave_bot
POSTGRES_USER=remnawave_user
POSTGRES_PASSWORD=CHANGE_ME      # <<< SET
REDIS_URL=redis://redis:6379/0

### Connection to the Remnawave panel ###
REMNAWAVE_API_URL=https://panel.example.com   # <<< SET (your PANEL_DOMAIN, https)
REMNAWAVE_API_KEY=                # <<< SET (panel → Settings → API Tokens)
REMNAWAVE_AUTH_TYPE=api_key
# UUID of the Remnawave "internal squad" new users are placed into.
# Create the squad in the panel first (runbook step 2), then paste its UUID.
SIMPLE_SUBSCRIPTION_SQUAD_UUID=   # <<< SET

### Trial: 7 days, granted for subscribing to the channel ###
TRIAL_DURATION_DAYS=7
TRIAL_TRAFFIC_LIMIT_GB=100        # generous cap for anti-abuse; 0 = unlimited
TRIAL_DEVICE_LIMIT=1
TRIAL_PAYMENT_ENABLED=false
# Anti-abuse: Bedolaga grants ONE trial per Telegram account (tracked in its DB) and,
# with CHANNEL_IS_REQUIRED_SUB below, requires channel membership. A person cannot
# self-create infinite trials without a new Telegram account each time.

### Require channel subscription for the trial.
### NOTE: the actual channel (@fodders_dev) is added in the BOT ADMIN PANEL,
### not here — this only turns the requirement on.
CHANNEL_IS_REQUIRED_SUB=true
CHANNEL_DISABLE_TRIAL_ON_UNSUBSCRIBE=true   # kills the trial if they unsubscribe
CHANNEL_REQUIRED_FOR_ALL=false              # paid users are not forced to stay subscribed

### Paid plan defaults ###
DEFAULT_DEVICE_LIMIT=3            # 3 devices included; extra billed at PRICE_PER_DEVICE
DEFAULT_TRAFFIC_LIMIT_GB=0        # 0 = unlimited (honest no-limit); verify in upstream
DEFAULT_TRAFFIC_RESET_STRATEGY=MONTH

### Renewal reminders + optional autopay from internal balance ###
DEFAULT_AUTOPAY_ENABLED=true
DEFAULT_AUTOPAY_DAYS_BEFORE=3

### Periods offered and prices (KOPEKS). ~150 RUB/mo, cheaper on longer terms. ###
AVAILABLE_SUBSCRIPTION_PERIODS=30,90,180,360
AVAILABLE_RENEWAL_PERIODS=30,90,180,360
PRICE_30_DAYS=15000              # 150.00 RUB
PRICE_90_DAYS=39000              # 130.00 RUB/mo
PRICE_180_DAYS=69000             # 115.00 RUB/mo
PRICE_360_DAYS=120000            # 100.00 RUB/mo
PRICE_PER_DEVICE=7000            # +70.00 RUB per extra device → "family" tier

### Referral (Bedolaga rewards BALANCE in kopeks, not days — tune in admin) ###
REFERRAL_PROGRAM_ENABLED=true

### Payments — Stars is the low-friction default for the MVP ###
TELEGRAM_STARS_ENABLED=true
TELEGRAM_STARS_RATE_RUB=1.0       # current upstream conversion setting
# Ruble path via Tribute (recurring sub on a closed channel) — enable when ready:
TRIBUTE_ENABLED=false
# YooKassa (self-employed) — only if a merchant account is approved; VPN often refused:
YOOKASSA_ENABLED=false
# Crypto (works, but accepting crypto for services by an RF resident is legally grey):
CRYPTOBOT_ENABLED=false

### Onboarding: open the subscription link inside a mini-app (best for iOS) ###
CONNECT_BUTTON_MODE=miniapp_subscription

### Keep the admin API private unless a separate frontend is deployed. ###
WEB_API_ENABLED=false

### Locale ###
DEFAULT_LANGUAGE=ru
TZ=Europe/Moscow

### AmneziaWG "premium stability" button (deploy/awg-fallback) ###
# The /awg button links to the vpn_wizard API. Without these the handler silently
# shows "AmneziaWG пока не настроен" (secret empty) or the link returns 403 (mismatch).
# VPNW_AWG_LINK_SECRET MUST be BYTE-EQUAL to the same var on the vpn_wizard side —
# the link token is HMAC-SHA256(telegram_id, this secret); any difference = 403.
VPNW_AWG_LINK_SECRET=            # <<< SET — identical to vpn_wizard's VPNW_AWG_LINK_SECRET
VPNW_AWG_PUBLIC_URL=            # <<< SET — https URL of the vpn_wizard API (e.g. https://vpn.example.com)
# Public labels only. This goes into the bot container; never put IPs, passwords or
# SSH keys here. The private VPNW_AWG_SERVERS registry belongs to /etc/vpn-wizard.env.
VPNW_AWG_PUBLIC_SERVERS='[{"id":"nl","display":"🇳🇱 Нидерланды"},{"id":"fi","display":"🇫🇮 Финляндия"},{"id":"tr","display":"🇹🇷 Турция"},{"id":"us","display":"🇺🇸 США"}]'
# Legacy one-server fallback used only when VPNW_AWG_PUBLIC_SERVERS is absent.
VPNW_AWG_SERVER_LABEL=🇳🇱 Нидерланды
# Unified portal opened by Telegram's menu button and /miniapp:
FODDERS_PORTAL_URL=            # e.g. https://vpn.example.com/miniapp
# Original Fodders VPN 1 bring-your-own-VPS wizard opened by /vpn1 and /wizard:
FODDERS_VPN1_MINIAPP_URL=      # e.g. https://vpn.example.com/wizard
