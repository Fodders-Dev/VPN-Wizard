# Fodder VPN 2 — Remnawave panel env.  Copy to `.env` next to docker-compose.yml.
#   cp panel.env.example .env
# Fill every value marked  <<< SET  before `docker compose up -d`.
# Full reference (all vars): https://docs.rw/docs/install/environment-variables
# Generate the secrets below with:  bash ../scripts/gen-secrets.sh

### APP ###
APP_PORT=3000
METRICS_PORT=3001
API_INSTANCES=1

### DATABASE (must match POSTGRES_* at the bottom) ###
DATABASE_URL="postgresql://postgres:CHANGE_ME_DB_PASSWORD@remnawave-db:5432/postgres"  # <<< SET (same pw as POSTGRES_PASSWORD)

### REDIS ###
REDIS_SOCKET=/var/run/valkey/valkey.sock

### JWT / secrets — run gen-secrets.sh, paste 64-char hex values ###
JWT_AUTH_SECRET=change_me        # <<< SET
JWT_API_TOKENS_SECRET=change_me  # <<< SET

### DOMAINS ###
# Panel admin UI domain (A-record -> this VPS).
PANEL_DOMAIN=panel.example.com                 # <<< SET
# CORS. Safe to leave * for a small private setup, or set to your panel domain.
FRONT_END_DOMAIN=*
# Public subscription domain WITHOUT scheme and WITHOUT trailing slash.
# With the bundled subscription-page (CUSTOM_SUB_PREFIX empty) use: sub.example.com
SUB_PUBLIC_DOMAIN=sub.example.com              # <<< SET

### DOCS (keep off in prod) ###
IS_DOCS_ENABLED=false
SWAGGER_PATH=/docs
SCALAR_PATH=/scalar

### PROMETHEUS METRICS (behind reverse proxy / localhost only) ###
METRICS_USER=admin
METRICS_PASS=change_me           # <<< SET (gen-secrets.sh)

### EXPIRATION NOTIFICATIONS (panel-side; Bedolaga also reminds) ###
EXPIRATION_NOTIFICATIONS_ENABLED=false
EXPIRATION_NOTIFICATIONS=[-72, -24, 24]

### Optional: native Telegram notifications from the panel itself. Bedolaga handles
### user-facing messages, so this can stay off for the MVP.
IS_TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_NOTIFY_USERS=change_me
TELEGRAM_NOTIFY_NODES=change_me

### POSTGRES container creds (NOT used by the app; must match DATABASE_URL) ###
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD   # <<< SET (same pw as in DATABASE_URL)
POSTGRES_DB=postgres
