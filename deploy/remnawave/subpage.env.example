# Fodder VPN 2 — Remnawave subscription page env.  Copy to `subpage.env`.
#   cp subpage.env.example subpage.env
# This is the client-facing page that shows "Install app" + "Add subscription"
# (deep-link) buttons. It is what non-technical users (esp. iOS) actually open.
# Full reference: https://github.com/remnawave/subscription-page

APP_PORT=3010

# Reach the panel over the internal docker network (no TLS hop needed here).
REMNAWAVE_PANEL_URL=http://remnawave:3000

# API token: create in panel → Remnawave Settings → API Tokens, paste here.
REMNAWAVE_API_TOKEN=            # <<< SET

# Serve at domain root. Leave empty when the page has its own subdomain
# (sub.example.com). If you set a prefix (e.g. "sub"), append it to the panel's
# SUB_PUBLIC_DOMAIN too.
CUSTOM_SUB_PREFIX=

# One reverse-proxy hop (Caddy) in front of this container.
TRUST_PROXY=1
