#!/usr/bin/env python3
"""Fodder VPN — сторож доступности из России.

Каждые 10 минут спрашивает у check-host.net, виден ли сервер с российских
нод и с контрольных зарубежных. Вердикты на каждую цель:

  ok       ru-ноды видят порт;
  blocked  ru-ноды не видят, зарубежные видят — похоже на блокировку;
  down     не видит никто — сервер лежит целиком, Россия ни при чём.

Состояние лежит в /var/lib/fodder-ru-watchdog/state.json. Владельцу уходит
Telegram-сообщение только на СМЕНУ состояния, плюс напоминание раз в 6 часов,
пока плохо, и отбой, когда починилось. Сбой самой проверки (check-host лёг,
сеть моргнула) алертом не считается: непонятно — значит молчим до следующего
запуска, а не будим среди ночи.

Токен и владелец берутся из окружения (EnvironmentFile=/etc/vpn-wizard.env):
VPNW_TELEGRAM_AUTH_TOKEN (или VPNW_BOT_TOKEN) и VPNW_OWNER_IDS.

Кроме доступности проверяются ресурсы каждой коробки (загрузка, память, диск и
давление на TCP-буферы ядра). 23.08.2026 панельный сервер был прекрасно доступен,
но TCP-память кончилась — и все TLS-хендшейки встали, а узнали мы об этом, только
когда сайт полностью лёг. Эти пороги предупреждают заранее.

Ещё проверяется, доходят ли до интерфейсов живые люди: интерфейс с профилями,
но без единого хендшейка, — это молча отрезанная аудитория (см. SILENT_HOURS).

Запуск с --test шлёт пробное сообщение и выходит — так проверяется доставка.
Запуск с --capacity печатает текущие цифры по всем коробкам и выходит.
Запуск с --interfaces печатает состояние интерфейсов и выходит.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.parse
import urllib.request

API = "https://check-host.net"
STATE_DIR = os.environ.get("STATE_DIRECTORY") or "/var/lib/fodder-ru-watchdog"
STATE_PATH = os.path.join(STATE_DIR, "state.json")
REMIND_SECONDS = 6 * 3600

TARGETS = [
    ("NL · сайт и панель", "77.67.89.164:443"),
    ("FI · экзит", "193.222.97.50:22"),
]
# ru4 на check-host почти всегда мёртв, поэтому его нет: молчащая нода не
# должна ни поднимать тревогу, ни маскировать её.
RU_NODES = [
    "ru1.node.check-host.net",
    "ru2.node.check-host.net",
    "ru3.node.check-host.net",
]
CONTROL_NODES = ["il2.node.check-host.net", "ro1.node.check-host.net"]


def http_json(url: str):
    # check-host.net отдаёт 403 дефолтному Python-urllib — любой другой UA проходит.
    request = urllib.request.Request(
        url,
        headers={"Accept": "application/json", "User-Agent": "fodder-ru-watchdog/1.0"},
    )
    with urllib.request.urlopen(request, timeout=25) as response:
        return json.loads(response.read().decode("utf-8"))


def run_check(host: str) -> dict[str, bool]:
    """Вернуть {нода: видит ли порт} только по успевшим ответить нодам."""
    query = urllib.parse.urlencode(
        [("host", host)] + [("node", n) for n in RU_NODES + CONTROL_NODES]
    )
    request_id = http_json(f"{API}/check-tcp?{query}")["request_id"]
    results: dict = {}
    for _ in range(4):
        time.sleep(10)
        results = http_json(f"{API}/check-result/{request_id}") or {}
        if results and all(value is not None for value in results.values()):
            break
    verdicts: dict[str, bool] = {}
    for node, payload in results.items():
        if payload is None:
            continue  # нода так и не ответила — не считаем ни туда, ни сюда
        entry = payload[0] if isinstance(payload, list) and payload else None
        verdicts[node] = bool(entry) and "error" not in entry
    return verdicts


def classify(verdicts: dict[str, bool]):
    ru = [ok for node, ok in verdicts.items() if node in RU_NODES]
    control = [ok for node, ok in verdicts.items() if node in CONTROL_NODES]
    if len(ru) < 2:
        return None  # мало данных — не вердикт
    if control and not any(control):
        # Зарубежные тоже слепы: если и ru молчат — сервер лежит целиком.
        return "down" if not any(ru) else None
    failed = sum(1 for ok in ru if not ok)
    if failed >= 2:
        return "blocked"
    return "ok"


def detail_line(verdicts: dict[str, bool]) -> str:
    def short(node: str) -> str:
        return node.split(".")[0]

    return ", ".join(
        f"{short(node)} {'✓' if ok else '✗'}"
        for node, ok in sorted(verdicts.items())
    )


# --- capacity ----------------------------------------------------------------
# Reachability is only half the story: on 2026-08-23 the panel box was perfectly
# reachable while TCP memory was exhausted, and every TLS handshake hung. Nothing
# said a word until the whole site was down. These are the numbers that would
# have caught it an hour earlier.
LOAD_PER_CORE = 4.0
MIN_MEM_PERCENT = 12.0
MIN_DISK_PERCENT = 10.0
MAX_TCP_MEM_PERCENT = 85.0

# --- silent interfaces ---------------------------------------------------------
# Every server metric can look perfect while the people are gone.  On 22.08.2026
# a migration rewrote 61 profiles with the new address, nobody handed the files
# out, and awg1 sat there with sixty-one peers and not one handshake for six
# days.  Load, memory, disk and reachability all said "fine" the whole time.
SILENT_HOURS = float(os.environ.get("VPNW_WATCHDOG_SILENT_HOURS") or 24)
# Below this an interface is a test bed or somebody's personal tunnel, not a
# product surface worth waking anyone up about.
MIN_PEERS_TO_JUDGE = 5

IFACE_PROBE = r"""
for i in $( (awg show interfaces; wg show interfaces) 2>/dev/null | tr ' ' '\n' | sort -u ); do
  [ -n "$i" ] || continue
  if awg show "$i" >/dev/null 2>&1; then t=awg; else t=wg; fi
  d=$($t show "$i" dump 2>/dev/null | tail -n +2)
  peers=$(printf '%s' "$d" | grep -c .)
  newest=$(printf '%s\n' "$d" | awk 'BEGIN{m=0}{if($5+0>m)m=$5+0}END{printf "%d", m}')
  ts=$(systemctl show "$t-quick@$i" -p ActiveEnterTimestamp --value 2>/dev/null)
  since=$(date -d "$ts" +%s 2>/dev/null || echo 0)
  mss=$(iptables -t mangle -S FORWARD 2>/dev/null | grep -c -- "-i $i .*--set-mss")
  sc=$( ($t --help; $t help) 2>&1 | grep -c syncconf )
  echo "IFACE|$i|$peers|$newest|${since:-0}|$mss|$sc"
done
"""


PROBE = r"""
cores=$(nproc)
load=$(cut -d' ' -f1 /proc/loadavg)
mem=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%.0f", a*100/t}' /proc/meminfo)
disk=$(df -P / | awk 'NR==2{gsub("%","",$5); print 100-$5}')
tcp=$(awk '/^TCP:/{for(i=1;i<=NF;i++) if($i=="mem") print $(i+1)}' /proc/net/sockstat)
tcpmax=$(awk '{print $3}' /proc/sys/net/ipv4/tcp_mem)
echo "$cores|$load|$mem|$disk|$tcp|$tcpmax"
"""


def remote_output(script: str, ssh_target=None):
    """Run a snippet locally or on an exit, returning (stdout, stderr)."""
    if ssh_target is None:
        argv = ["sh", "-c", script]
    else:
        host, user, port, key = ssh_target
        argv = [
            "ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
            "-o", "StrictHostKeyChecking=accept-new",
            "-p", str(port), "-i", key, f"{user}@{host}", script,
        ]
    out = subprocess.run(argv, capture_output=True, text=True, timeout=40)
    return out.stdout or "", out.stderr or ""


def probe(ssh_target=None):
    """Read load/memory/disk/TCP pressure, locally or over SSH."""
    stdout, stderr = remote_output(PROBE, ssh_target)
    out = type("R", (), {"stdout": stdout, "stderr": stderr})()
    parts = (out.stdout or "").strip().splitlines()[-1].split("|")
    if len(parts) != 6:
        raise RuntimeError(f"unreadable probe: {out.stdout!r} {out.stderr[:120]!r}")
    cores, load, mem, disk, tcp, tcpmax = parts
    return {
        "load_per_core": float(load) / max(1, int(cores)),
        "mem_percent": float(mem),
        "disk_percent": float(disk),
        "tcp_percent": (float(tcp) * 100 / float(tcpmax)) if tcp and float(tcpmax) else 0.0,
    }


def capacity_complaints(stats: dict) -> list[str]:
    out = []
    if stats["load_per_core"] > LOAD_PER_CORE:
        out.append(f"загрузка {stats['load_per_core']:.1f} на ядро")
    if stats["mem_percent"] < MIN_MEM_PERCENT:
        out.append(f"свободной памяти {stats['mem_percent']:.0f}%")
    if stats["disk_percent"] < MIN_DISK_PERCENT:
        out.append(f"свободного диска {stats['disk_percent']:.0f}%")
    if stats["tcp_percent"] > MAX_TCP_MEM_PERCENT:
        # The exact failure of 2026-08-23: TLS dies while HTTP still answers.
        out.append(f"TCP-буферы ядра на {stats['tcp_percent']:.0f}% — TLS вот-вот встанет")
    return out


# Interfaces the product creates when it owns the whole machine.
PRODUCT_INTERFACES = ("awg0", "awg1", "wg0")


def own_interfaces(server: dict | None = None) -> tuple[str, ...]:
    """Which interfaces on a box are ours to judge.

    A dedicated exit runs beside somebody's personal tunnels. Complaining that
    their awg0 has no MSS rule would be noise, and on the Finnish box it would
    be wrong too: that tunnel is MTU 1420 end to end and needs no clamp.
    """
    if server and server.get("interface"):
        return (str(server["interface"]),)
    return PRODUCT_INTERFACES


def exit_targets() -> list[tuple[str, tuple, tuple]]:
    """Remote exits from VPNW_AWG_SERVERS, skipping the local one."""
    try:
        servers = json.loads(os.environ.get("VPNW_AWG_SERVERS") or "[]")
    except ValueError:
        return []
    targets = []
    for s in servers:
        host = str(s.get("host") or "")
        key = s.get("key_path")
        if not host or not key or host.startswith("127.") or s.get("enabled") is False:
            continue
        targets.append(
            (
                f"{s.get('label') or s.get('id')} ({host})",
                (host, s.get("user") or "root", s.get("port") or 22, key),
                own_interfaces(s),
            )
        )
    return targets


def all_boxes() -> list[tuple[str, tuple | None, tuple]]:
    return [("NL · панель и сайт", None, own_interfaces())] + exit_targets()


def notify(text: str) -> None:
    token = (
        os.environ.get("VPNW_TELEGRAM_AUTH_TOKEN")
        or os.environ.get("VPNW_BOT_TOKEN")
        or ""
    ).strip()
    owner = (os.environ.get("VPNW_OWNER_IDS") or "").split(",")[0].strip()
    if not token or not owner:
        print("watchdog: no bot token or owner id in environment", file=sys.stderr)
        return
    body = urllib.parse.urlencode({"chat_id": owner, "text": text}).encode()
    request = urllib.request.Request(
        f"https://api.telegram.org/bot{token}/sendMessage", data=body
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        response.read()


MESSAGES = {
    "blocked": (
        "🚨 {name}: {host} НЕ виден из России ({detail}), из-за рубежа отвечает — "
        "похоже на блокировку.\n\nПлейбук: 1) поднять новый IP/сервер; "
        "2) оповестить людей — пост в @fodders_dev, рассылка в админке бота, "
        "SMS тем, кто без Telegram; 3) после переезда обновить status.json."
    ),
    "down": (
        "💥 {name}: {host} не отвечает вообще, даже из-за рубежа ({detail}) — "
        "лежит сервер или порт, Россия ни при чём."
    ),
    "ok": "✅ {name}: {host} снова виден из России ({detail}).",
}

CAPACITY_MESSAGES = {
    "tight": (
        "📈 {name}: сервер упирается в ресурсы — {detail}.\n\n"
        "Пока работает, но запаса нет. Стоит подумать об апгрейде тарифа "
        "или о переносе части людей на другой экзит."
    ),
    "ok": "✅ {name}: с ресурсами снова порядок ({detail}).",
}


def parse_iface_probe(text: str) -> list[dict]:
    rows = []
    for line in (text or "").splitlines():
        parts = line.strip().split("|")
        if len(parts) != 7 or parts[0] != "IFACE":
            continue
        try:
            rows.append(
                {
                    "iface": parts[1],
                    "peers": int(parts[2] or 0),
                    "newest_handshake": int(parts[3] or 0),
                    "up_since": int(parts[4] or 0),
                    "has_mss_rule": int(parts[5] or 0) > 0,
                    "has_syncconf": int(parts[6] or 0) > 0,
                }
            )
        except ValueError:
            continue
    return rows


def interface_complaints(rows: list[dict], now: int, own: tuple[str, ...] = PRODUCT_INTERFACES) -> list[dict]:
    """What is wrong with our interfaces, and of which kind.

    Three different faults come out of here, and they need different answers
    from the owner, so each carries its kind rather than being flattened into
    one word.

    A handshake age only means something once the interface has been up longer
    than the window: restarting it zeroes every handshake, so a freshly
    restarted interface always looks abandoned for a while. Whether the config
    is right, on the other hand, does not depend on how many people are on it —
    a two-peer exit without the clamp loses large TCP exactly like a fifty-peer
    one, so those checks run at any size.
    """
    window = SILENT_HOURS * 3600
    out = []

    def add(kind: str, iface: str, text: str) -> None:
        out.append({"kind": kind, "iface": iface, "text": text})

    for row in rows:
        if row["iface"] not in own:
            continue
        if not row["has_mss_rule"]:
            add(
                "mss",
                row["iface"],
                f"{row['iface']}: нет правила TCPMSS --set-mss, "
                "крупные TCP-пакеты будут молча пропадать",
            )
        if not row["has_syncconf"]:
            add(
                "syncconf",
                row["iface"],
                f"{row['iface']}: тулза без syncconf — "
                "выдача профиля будет рвать сессии всем",
            )
        if row["peers"] < MIN_PEERS_TO_JUDGE:
            continue
        settled = row["up_since"] and now - row["up_since"] > window
        if settled and now - row["newest_handshake"] > window:
            if row["newest_handshake"]:
                hours = int((now - row["newest_handshake"]) // 3600)
                add(
                    "silent",
                    row["iface"],
                    f"{row['iface']}: {row['peers']} профилей, "
                    f"последнее подключение {hours} ч назад",
                )
            else:
                hours = int((now - row["up_since"]) // 3600)
                add(
                    "silent",
                    row["iface"],
                    f"{row['iface']}: {row['peers']} профилей и "
                    f"ни одного подключения за {hours} ч",
                )
    return out


INTERFACE_MESSAGES = {
    "silent": (
        "🔇 {name}: {detail}.\n\n"
        "Сервер при этом жив и по ресурсам в порядке — значит люди до него не "
        "доходят. Чаще всего это старый адрес в их приложении после смены IP: "
        "профили на сервере уже новые, а на руках у людей — прежние. "
        "Проверь, роздали ли им обновлённые файлы."
    ),
    "mss": (
        "🧱 {name}: {detail}.\n\n"
        "Это настройка экзита, а не люди. Туннель будет подниматься, мелочь "
        "ходить, а крупные TCP-пакеты гибнуть молча — сайты виснут, фото не "
        "грузятся. Смотреть: iptables -t mangle -S FORWARD | grep set-mss"
    ),
    "syncconf": (
        "🧰 {name}: {detail}.\n\n"
        "Пока этого нет, выдача одного профиля рвёт сессии всем на интерфейсе. "
        "Нужны amneziawg-tools с подкомандой syncconf."
    ),
    "ok": "✅ {name}: интерфейсы снова живые ({detail}).",
}

# A broken config is something the owner can go and fix right now; silence is a
# question about people. Lead with the actionable one.
KIND_PRIORITY = ("mss", "syncconf", "silent")


def check_interfaces(state: dict, now: int) -> None:
    for name, target, own in all_boxes():
        try:
            stdout, stderr = remote_output(IFACE_PROBE, target)
            rows = parse_iface_probe(stdout)
            if not rows:
                raise RuntimeError(f"no interfaces parsed: {stderr[:120]!r}")
        except Exception as exc:  # a failed probe is not a verdict
            print(f"watchdog: interface probe failed for {name}: {exc}", file=sys.stderr)
            continue
        complaints = interface_complaints(rows, now, own)
        kinds = {c["kind"] for c in complaints}
        status = next((k for k in KIND_PRIORITY if k in kinds), "ok")
        detail = "; ".join(c["text"] for c in complaints) or ", ".join(
            f"{r['iface']}×{r['peers']}" for r in rows if r["iface"] in own
        )
        key = f"ifaces:{name}"
        entry = state.get(key) or {"status": "ok", "since": now, "last_alert": 0}
        # Track WHICH interface has WHICH fault, not just that something is
        # wrong: with a single per-box flag, a second interface going quiet
        # while the first already is would never raise a word, and an interface
        # swapping one fault for another would look unchanged.
        culprits = sorted(f"{c['iface']}:{c['kind']}" for c in complaints)
        known = entry.get("culprits")  # absent in entries written before this
        changed = status != entry["status"] or (known is not None and culprits != known)
        entry["culprits"] = culprits
        bad = status != "ok"
        stale = bad and now - int(entry.get("last_alert") or 0) >= REMIND_SECONDS
        if (changed or stale) and (bad or entry["status"] != "ok"):
            text = INTERFACE_MESSAGES[status].format(name=name, detail=detail)
            if not changed:
                text = "⏰ Всё ещё так.\n" + text
            try:
                notify(text)
                entry["last_alert"] = now
            except Exception as exc:
                print(f"watchdog: notify failed: {exc}", file=sys.stderr)
        if changed:
            entry["status"] = status
            entry["since"] = now
        state[key] = entry


def check_capacity(state: dict, now: int) -> None:
    """Warn while a box still works, instead of after it stops."""
    for name, target, _own in all_boxes():
        try:
            stats = probe(target)
        except Exception as exc:  # a probe failure is not a capacity verdict
            print(f"watchdog: capacity probe failed for {name}: {exc}", file=sys.stderr)
            continue
        complaints = capacity_complaints(stats)
        status = "tight" if complaints else "ok"
        detail = ", ".join(complaints) or (
            f"загрузка {stats['load_per_core']:.1f}/ядро, память {stats['mem_percent']:.0f}%, "
            f"диск {stats['disk_percent']:.0f}%"
        )
        key = f"capacity:{name}"
        entry = state.get(key) or {"status": "ok", "since": now, "last_alert": 0}
        changed = status != entry["status"]
        stale = status == "tight" and now - int(entry.get("last_alert") or 0) >= REMIND_SECONDS
        if (changed or stale) and (status == "tight" or entry["status"] == "tight"):
            text = CAPACITY_MESSAGES[status].format(name=name, detail=detail)
            if not changed:
                text = "⏰ Всё ещё тесно.\n" + text
            try:
                notify(text)
                entry["last_alert"] = now
            except Exception as exc:
                print(f"watchdog: notify failed: {exc}", file=sys.stderr)
        if changed:
            entry["status"] = status
            entry["since"] = now
        state[key] = entry


def main() -> int:
    if "--capacity" in sys.argv:
        for name, target, _own in all_boxes():
            try:
                stats = probe(target)
            except Exception as exc:
                print(f"{name}: probe failed: {exc}")
                continue
            print(
                f"{name}: загрузка {stats['load_per_core']:.2f}/ядро, "
                f"память {stats['mem_percent']:.0f}% свободно, "
                f"диск {stats['disk_percent']:.0f}% свободно, "
                f"TCP-буферы {stats['tcp_percent']:.0f}% лимита"
                + (f"  ⚠ {', '.join(capacity_complaints(stats))}" if capacity_complaints(stats) else "")
            )
        return 0

    if "--interfaces" in sys.argv:
        now = int(time.time())
        for name, target, own in all_boxes():
            try:
                stdout, stderr = remote_output(IFACE_PROBE, target)
            except Exception as exc:
                print(f"{name}: probe failed: {exc}")
                continue
            rows = parse_iface_probe(stdout)
            if not rows:
                print(f"{name}: no interfaces parsed ({stderr[:80]!r})")
                continue
            for row in rows:
                age = (
                    f"{int((now - row['newest_handshake']) // 3600)} ч назад"
                    if row["newest_handshake"]
                    else "никогда"
                )
                print(
                    f"{name} · {row['iface']}: {row['peers']} профилей, "
                    f"последнее подключение {age}, "
                    f"MSS {'да' if row['has_mss_rule'] else 'НЕТ'}, "
                    f"syncconf {'да' if row['has_syncconf'] else 'НЕТ'}"
                    + ("" if row["iface"] in own else "   (не наш, не оцениваем)")
                )
            for c in interface_complaints(rows, now, own):
                print(f"  ⚠ [{c['kind']}] {c['text']}")
        return 0

    if "--test" in sys.argv:
        notify(
            "🔔 Тест сторожа Fodder VPN: алерты доходят. Каждые 10 минут проверяю "
            "NL 77.67.89.164:443 и FI 193.222.97.50:22 из ru1/ru2/ru3."
        )
        return 0

    try:
        with open(STATE_PATH, encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, ValueError):
        state = {}

    now = int(time.time())
    for name, host in TARGETS:
        try:
            verdicts = run_check(host)
            status = classify(verdicts)
        except Exception as exc:  # сбой проверки — не повод для тревоги
            print(f"watchdog: check failed for {host}: {exc}", file=sys.stderr)
            continue
        if status is None:
            continue
        entry = state.get(host) or {"status": "ok", "since": now, "last_alert": 0}
        changed = status != entry["status"]
        stale = status != "ok" and now - int(entry.get("last_alert") or 0) >= REMIND_SECONDS
        if changed or stale:
            # Отбой шлём только если до этого было плохо: первый же запуск со
            # статусом ok не должен ничего писать.
            if status != "ok" or entry["status"] != "ok":
                text = MESSAGES[status].format(
                    name=name, host=host, detail=detail_line(verdicts)
                )
                if not changed:
                    text = "⏰ Всё ещё плохо.\n" + text
                try:
                    notify(text)
                    entry["last_alert"] = now
                except Exception as exc:
                    print(f"watchdog: notify failed: {exc}", file=sys.stderr)
        if changed:
            entry["status"] = status
            entry["since"] = now
        state[host] = entry

    check_capacity(state, now)
    check_interfaces(state, now)

    os.makedirs(STATE_DIR, exist_ok=True)
    with open(STATE_PATH, "w", encoding="utf-8") as handle:
        json.dump(state, handle)
    return 0


if __name__ == "__main__":
    sys.exit(main())
