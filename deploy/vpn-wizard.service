[Unit]
Description=VPN Wizard combined API, miniapp, and Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vpn-wizard/app
EnvironmentFile=/etc/vpn-wizard.env
ExecStart=/opt/vpn-wizard/venv/bin/python -m vpn_wizard.combined
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
