[Unit]
Description=Restrict Remnawave node management port to the panel
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/remnanode-firewall
ExecStart=/usr/local/sbin/remnanode-firewall
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
